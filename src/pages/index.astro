---
import Layout from '../layouts/Layout.astro';
import Picture from '../components/Picture.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { projects, services } from '../data/projects';
---
<Layout title="Архитектура начинается с места" description="TEREN — концептуальная архитектурная студия. Частные дома, интерьеры и общественные пространства, в которых место определяет решение.">
  <section class="home-hero wrap">
    <div class="hero-topline eyebrow"><span>Независимая архитектурная практика</span><span>Portfolio concept / 2026</span></div>
    <h1><span class="line">Архитектура</span><span class="line second">начинается <em>с места.</em></span></h1>
    <div class="hero-bottom"><p>Проектируем дома и пространства.<br />Внимательно к контексту. Близко к человеку.</p><a class="text-link" href="/projects/">Смотреть проекты <span class="tiny-square" aria-hidden="true"></span></a></div>
    <figure class="hero-image"><Picture name="residence" eager alt="Каменный дом среди сосен: открытый двор и тёплый свет под длинной горизонталью кровли" /><figcaption><span>01 / Дом среди сосен</span><span>Южное побережье · 280 м²</span><a href="/projects/residence-01/">Исследовать проект</a></figcaption><span class="image-stamp" aria-hidden="true">T / 01</span></figure>
  </section>
  <section class="intro section wrap"><span class="eyebrow">01 / Точка отсчёта</span><div><h2 data-reveal>Не добавлять лишнее.<br />Находить <span class="muted">необходимое.</span></h2><div class="intro-bottom"><p>Прежде чем провести первую линию, мы изучаем место: как движется свет, где растут деревья, что видно из окна. Архитектура становится продолжением этого наблюдения.</p><a class="text-link" href="/studio/">О студии <span class="tiny-square" aria-hidden="true"></span></a></div></div></section>
  <section class="selected section wrap" aria-labelledby="selected-heading"><aside class="project-sidebar"><span class="eyebrow">02 / Избранное</span><h2 id="selected-heading">Три масштаба.<br />Один подход.</h2><div class="project-index">{projects.map(p => <a href={`#selected-${p.n}`} data-project-link={p.n}><span>{p.n}</span>{p.title}<span class="index-dot" aria-hidden="true"></span></a>)}</div><a class="text-link" href="/projects/">Все проекты <span class="tiny-square" aria-hidden="true"></span></a></aside><div class="selected-images">{projects.map(p => <article class="selected-project" id={`selected-${p.n}`} data-project={p.n}><a class="project-photo" href={`/projects/${p.id}/`} aria-label={`Открыть проект «${p.title}»`}><Picture name={p.image} alt={p.alt} sizes="(max-width: 760px) 100vw, 65vw" /><span class="photo-action">Смотреть проект</span></a><div class="project-caption"><h3><span>{p.n}</span> {p.title}</h3><span>{p.type} / {p.year}</span></div></article>)}</div></section>
  <section class="approach section wrap"><div class="section-heading"><span class="eyebrow">03 / Принципы</span><h2 data-reveal>Спокойная форма.<br />Точное решение.</h2></div><div class="principles"><article><span>01 — Контекст</span><h3>Сначала слушать</h3><p>Рельеф, свет и окружение задают исходные условия. Мы работаем с ними, а не поверх них.</p></article><article><span>02 — Материал</span><h3>Оставлять настоящим</h3><p>Камень, дерево и бетон не нуждаются в имитации. Их фактура и старение — часть замысла.</p></article><article><span>03 — Человек</span><h3>Думать о повседневном</h3><p>Удобный путь, место для тишины, свет над столом. Большая идея проверяется в мелочах.</p></article></div></section>
  <section class="visual-break"><Picture name="interior" alt="Дневной свет на дубовом столе и фактурной каменной стене" /><div><span class="eyebrow">Материал / Свет / Время</span><p>Пространство,<br />которое остаётся.</p></div></section>
  <section class="home-services section wrap"><div><span class="eyebrow">04 / Практика</span><h2>От ландшафта<br />до прикосновения.</h2><p>Работаем в разных масштабах.<br />Сохраняем внимание к каждому.</p></div><div class="service-list">{services.slice(0,4).map(s => <a href={`/services/#service-${s.n}`}><small>{s.n}</small><h3>{s.name}</h3><span>{s.en}</span></a>)}</div></section>
  <section class="process section wrap"><div class="section-heading"><span class="eyebrow">05 / Процесс</span><h2 data-reveal>От вопроса<br />к пространству.</h2></div><ol>{[['Исследуем','Знакомимся с местом, задачей и образом жизни. Формируем ясный бриф.'],['Предлагаем','Проверяем планировки, объёмы и материалы. Выбираем обоснованное решение.'],['Проектируем','Переводим концепцию в точные чертежи и согласованные спецификации.'],['Сопровождаем','Помогаем реализовать проект, сохраняя его смысл в каждой детали.']].map(([title,text],i) => <li><span>0{i+1}</span><h3>{title}</h3><p>{text}</p></li>)}</ol></section>
  <ContactCTA />
</Layout>
